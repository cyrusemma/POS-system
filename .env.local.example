# Supabase Configuration
# Get these values from your Supabase Dashboard → Settings → API
SUPABASE_URL=https://ngjtygpuykvzlnnjqmdo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paystack Configuration  
# Get this from Paystack Dashboard → Settings → API Keys & Webhooks
# Use the LIVE secret key (starts with sk_live_)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# ⚠️ IMPORTANT: Keep this file PRIVATE
# Add to .gitignore and NEVER commit to version control
# If you accidentally commit secrets, rotate them immediately in Supabase/Paystack dashboards
